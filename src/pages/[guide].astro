---
import GuidePage from '@/components/GuidePage.astro';
import { GUIDES, guidePaths, type GuideKey } from '@/i18n/config';

export function getStaticPaths() {
  return GUIDES.map((key) => ({
    params: { guide: guidePaths[key].ms.replace(/^\/|\/$/g, '') },
    props: { guide: key },
  }));
}

const { guide } = Astro.props;
---

<GuidePage locale="ms" guide={guide} />
