---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import {
  SITE,
  KEY_INFO,
  PRODUCT_CATEGORIES,
  TICKET_INFO,
  PARKING,
  TRANSPORT,
  FOOD_SPOTS,
  NEARBY_ATTRACTIONS,
  GALLERY,
} from '@/consts';

const modeLabels: Record<string, { label: string; icon: string }> = {
  kapal_terbang: { label: 'Kapal Terbang', icon: '✈' },
  bas: { label: 'Bas Bandar', icon: '🚌' },
  teksi: { label: 'Teksi', icon: '🚕' },
  grab: { label: 'Grab / E-Hailing', icon: '📱' },
  berjalan: { label: 'Berjalan Kaki', icon: '🚶' },
  kereta: { label: 'Kereta Sendiri', icon: '🚗' },
};

const priceBadge: Record<string, string> = {
  murah: 'bg-sabah-ocean-100 text-sabah-ocean-700',
  sederhana: 'bg-sabah-sand-200 text-sabah-wood-700',
  mewah: 'bg-sabah-batik-100 text-sabah-batik-700',
};

const priceLabel: Record<string, string> = {
  murah: 'Ekonomi',
  sederhana: 'Sederhana',
  mewah: 'Mewah',
};
---

<BaseLayout>
  <!-- SECTION 1: HERO -->
  <section id="hero" class="relative overflow-hidden">
    <div class="relative h-[72vh] min-h-[520px] w-full">
      <img
        src={GALLERY[0]}
        alt={SITE.name}
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 hero-overlay" />
    </div>
    <div class="container relative -mt-16 md:-mt-20 pb-6 md:pb-10">
      <div class="max-w-3xl text-white">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/15 backdrop-blur border border-white/20 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-white/90">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          Kota Kinabalu · Sabah · Malaysia
        </span>
        <h1 class="mt-5 font-display text-4xl md:text-6xl font-bold tracking-tight leading-[1.1]">
          {SITE.name}
        </h1>
        <p class="mt-5 text-lg md:text-xl leading-relaxed text-white/90 max-w-2xl">
          {SITE.description}
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="#kategori" class="btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            Teroka Produk
          </a>
          <a href="#pengangkutan" class="btn-secondary !bg-white/85 !text-sabah-ocean-900 hover:!bg-white">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2Z"/><path d="M12 2v4"/><path d="m16.2 7.8 2.9-2.9"/><path d="M18 12h4"/><path d="m19 16-3-2"/></svg>
            Cara Ke Sana
          </a>
        </div>
        <div class="mt-7 flex flex-wrap items-center gap-4 text-sm text-white/85">
          <span class="inline-flex items-center gap-2">
            <span class="inline-flex gap-0.5 text-amber-300">
              ★★★★★
            </span>
            <span class="font-semibold text-white">{SITE.ratingValue.toFixed(1)}</span>
            <span>· {SITE.reviewCount.toLocaleString('ms-MY')} ulasan</span>
          </span>
          <span class="h-4 w-px bg-white/25"></span>
          <span class="inline-flex items-center gap-1.5">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            9:00 AM – 6:00 PM · Setiap hari
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: INFO PENTING (KEY INFO CARDS) -->
  <section id="info-penting" class="scroll-mt-24">
    <div class="container py-10 md:py-14">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {KEY_INFO.map((k) => (
          <div class="card p-5 md:p-6">
            <div class="flex items-start gap-4">
              <div class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-sabah-ocean-100 text-sabah-ocean-700">
                {k.icon === 'ticket' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg>
                )}
                {k.icon === 'clock' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                )}
                {k.icon === 'stopwatch' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2"/><path d="M5 3 2 6"/><path d="m22 6-3-3"/><path d="M9 2h6"/></svg>
                )}
                {k.icon === 'sun' && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
                )}
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-xs font-semibold uppercase tracking-wider text-sabah-ocean-500">
                  {k.label}
                </p>
                <p class="mt-1 font-display text-lg md:text-xl font-bold text-sabah-ocean-900 break-words">
                  {k.value}
                </p>
                <p class="mt-1 text-sm text-sabah-ocean-600">{k.sub}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 3: KATEGORI PRODUK -->
  <section id="kategori" class="scroll-mt-24 pattern-weave">
    <div class="container py-16 md:py-20">
      <div class="max-w-3xl mb-10 md:mb-12">
        <span class="section-eyebrow">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          Koleksi Kraftangan Sabah
        </span>
        <h2 class="section-title mt-3">Kategori Produk Utama</h2>
        <p class="mt-3 text-sabah-ocean-700 leading-prose">
          Lebih 100 gerai menawarkan pelbagai barangan kraftangan tradisional
          Sabah. Dari kain tenun warisan suku kaum, hingga mutiara air masin
          Laut China Selatan — setiap karya mempunyai cerita budayanya sendiri.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {PRODUCT_CATEGORIES.map((p, i) => (
          <article class="card p-6 hover:shadow-lg transition">
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-sabah-wood-100 text-sabah-wood-700 font-bold font-display">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="chip-accent">{p.tagline}</span>
            </div>
            <h3 class="font-display text-xl font-bold text-sabah-ocean-900 leading-snug">
              {p.title}
            </h3>
            <p class="mt-2 text-sm text-sabah-ocean-700 leading-relaxed">
              {p.description}
            </p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {p.items.map((it) => (
                <li class="chip">
                  {it}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 4: GALERI -->
  <section id="galeri" class="scroll-mt-24">
    <div class="container py-16 md:py-20">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10 md:mb-12">
        <div class="max-w-3xl">
          <span class="section-eyebrow">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            Galeri Gambar
          </span>
          <h2 class="section-title mt-3">Sekitar Pasar Kraftangan</h2>
          <p class="mt-3 text-sabah-ocean-700 leading-prose">
            20 gambar sebenar Pasar Kraftangan Kota Kinabalu — suasana gerai,
            butiran kraftangan, dan pemandangan laut yang mengiringi lawatan
            anda di tengah bandar.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
        {GALLERY.map((src, i) => (
          <figure
            class={`group relative overflow-hidden rounded-xl bg-sabah-ocean-100 ${
              i === 0 || i === 11 ? 'md:col-span-2 md:row-span-2 aspect-square' : 'aspect-[4/5]'
            }`}
          >
            <img
              src={src}
              alt={`Gambar ${i + 1} Pasar Kraftangan Kota Kinabalu, Sabah`}
              loading={i < 4 ? 'eager' : 'lazy'}
              decoding="async"
              class="h-full w-full object-cover group-hover:scale-105 transition duration-500"
              width="800"
              height="800"
            />
            <figcaption class="pointer-events-none absolute bottom-0 left-0 right-0 bg-gradient-to-t from-sabah-ocean-950/70 via-sabah-ocean-950/20 to-transparent p-3 text-xs font-medium text-white/90 opacity-0 group-hover:opacity-100 transition">
              Foto #{String(i + 1).padStart(2, '0')}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 5: TIKET & YURAN -->
  <section id="tiket" class="scroll-mt-24 bg-sabah-ocean-50/60">
    <div class="container py-16 md:py-20">
      <div class="grid gap-10 lg:grid-cols-12 items-start">
        <div class="lg:col-span-5">
          <span class="section-eyebrow">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/></svg>
            Tiket & Yuran
          </span>
          <h2 class="section-title mt-3">Kemasukan adalah PERCUMA</h2>
          <p class="mt-4 text-sabah-ocean-700 leading-prose">
            Tiada bayaran masuk dikenakan ke atas semua pelawat, sama ada
            rakyat Malaysia mahupun pelancong antarabangsa. Anda hanya perlu
            membayar untuk barang yang dibeli, parkir kenderaan, dan perkhidmatan
            makan di dalam pasar.
          </p>
          <div class="mt-6 card p-5 border-sabah-batik-200 bg-sabah-batik-50/60">
            <p class="text-sm font-semibold text-sabah-batik-800 mb-2">💡 Tips Pembelian</p>
            <ul class="text-sm text-sabah-ocean-800 space-y-1.5 leading-relaxed list-disc pl-5">
              <li>Menawar harga adalah amalan biasa, terutamanya untuk belian banyak.</li>
              <li>Bawa wang tunai secukupnya — kebanyakan gerai kecil tidak terima kad.</li>
              <li>Minta resit jika membeli barang berharga seperti mutiara.</li>
            </ul>
          </div>
        </div>
        <div class="lg:col-span-7">
          <div class="card overflow-hidden">
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-sabah-ocean-100 text-sm">
                <thead class="bg-sabah-ocean-900 text-white">
                  <tr>
                    <th scope="col" class="text-left px-5 py-4 font-semibold tracking-wide">Kategori Pengunjung</th>
                    <th scope="col" class="text-left px-5 py-4 font-semibold tracking-wide">Yuran Masuk</th>
                    <th scope="col" class="text-left px-5 py-4 font-semibold tracking-wide">Nota</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-sabah-ocean-100 bg-white">
                  {TICKET_INFO.map((t) => (
                    <tr class="hover:bg-sabah-sand-50">
                      <td class="px-5 py-4 font-semibold text-sabah-ocean-900">{t.type}</td>
                      <td class="px-5 py-4">
                        <span class="inline-flex items-center gap-2 rounded-full bg-sabah-ocean-100 px-3 py-1 text-xs font-bold text-sabah-ocean-700">
                          {t.price}
                        </span>
                      </td>
                      <td class="px-5 py-4 text-sabah-ocean-700">{t.note}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 6: MASA TERBAIK -->
  <section id="masa-terbaik" class="scroll-mt-24">
    <div class="container py-16 md:py-20">
      <div class="max-w-3xl mb-10 md:mb-12">
        <span class="section-eyebrow">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          Masa Terbaik & Tempoh Lawatan
        </span>
        <h2 class="section-title mt-3">Bila & Berapa Lama Sebaiknya?</h2>
        <p class="mt-3 text-sabah-ocean-700 leading-prose">
          Pasar Kraftangan dibuka setiap hari, tetapi terdapat jangka masa
          yang lebih sesuai untuk pengalaman beli-belah yang selesa — kurang
          sesak, pilihan gerai lengkap, dan udara yang masih sejuk di pesisiran
          laut.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        <article class="card p-6 border-t-4 border-t-sabah-ocean-500">
          <div class="flex items-center gap-3 mb-4">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-sabah-ocean-100 text-sabah-ocean-700">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 8 1.45-2.9A2 2 0 0 1 9.24 4H20a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2Z"/></svg>
            </span>
            <h3 class="font-display text-xl font-bold text-sabah-ocean-900">Waktu Pagi</h3>
          </div>
          <p class="text-xs font-semibold text-sabah-wood-600 uppercase tracking-wider">Terbaik · ⭐⭐⭐⭐⭐</p>
          <p class="mt-2 font-bold text-sabah-ocean-900">10:00 AM – 1:00 PM</p>
          <ul class="mt-3 text-sm text-sabah-ocean-700 space-y-1.5 list-disc pl-5">
            <li>Semua gerai sudah penuh beroperasi</li>
            <li>Kurang sesak, mudah tawar-menawar harga</li>
            <li>Udara masih sejuk sebelum matahari tinggi</li>
          </ul>
        </article>

        <article class="card p-6 border-t-4 border-t-sabah-wood-500">
          <div class="flex items-center gap-3 mb-4">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-sabah-wood-100 text-sabah-wood-700">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/></svg>
            </span>
            <h3 class="font-display text-xl font-bold text-sabah-ocean-900">Waktu Petang</h3>
          </div>
          <p class="text-xs font-semibold text-sabah-wood-600 uppercase tracking-wider">Bagus · ⭐⭐⭐⭐</p>
          <p class="mt-2 font-bold text-sabah-ocean-900">3:00 PM – 5:30 PM</p>
          <ul class="mt-3 text-sm text-sabah-ocean-700 space-y-1.5 list-disc pl-5">
            <li>Cuaca semakin sejuk selepas matahari condong</li>
            <li>Beberapa penjual memberi diskaun akhir hari</li>
            <li>Sesuai selepas jalan-jalan di Gaya Street</li>
          </ul>
        </article>

        <article class="card p-6 border-t-4 border-t-sabah-batik-500">
          <div class="flex items-center gap-3 mb-4">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-sabah-batik-100 text-sabah-batik-700">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 21a8 8 0 0 0-16 0"/><circle cx="10" cy="8" r="5"/><path d="M22 16a5 5 0 0 0-5-5"/><path d="M17 22h4"/></svg>
            </span>
            <h3 class="font-display text-xl font-bold text-sabah-ocean-900">Tempoh Disyorkan</h3>
          </div>
          <p class="text-xs font-semibold text-sabah-wood-600 uppercase tracking-wider">Kesesuaian · ⭐⭐⭐⭐⭐</p>
          <p class="mt-2 font-bold text-sabah-ocean-900">1.5 – 2 jam yang santai</p>
          <ul class="mt-3 text-sm text-sabah-ocean-700 space-y-1.5 list-disc pl-5">
            <li>30 minit: Melintas pantas & belian ringkas</li>
            <li>2 jam: Pilihan teliti + tawar-menawar + food court</li>
            <li>Sekiranya gabung Jesselton Point: 1 hari penuh</li>
          </ul>
        </article>
      </div>

      <div class="mt-10 card p-6 md:p-8 bg-gradient-to-br from-sabah-ocean-50 to-sabah-sand-50 border-sabah-ocean-200">
        <div class="grid gap-6 md:grid-cols-2 items-start">
          <div>
            <p class="font-display text-lg md:text-xl font-bold text-sabah-ocean-900">
              📅 Hari Paling Sesuai Lawat
            </p>
            <ul class="mt-3 text-sm text-sabah-ocean-800 space-y-2 leading-relaxed">
              <li class="flex items-start gap-2">
                <span class="mt-0.5 font-semibold text-sabah-ocean-700">Isnin – Khamis:</span>
                <span>Kurang pelancong, ruang lebih luas untuk memilih barang.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-0.5 font-semibold text-sabah-wood-700">Jumaat:</span>
                <span>Sedikit sesak pada waktu tengahari waktu rehat pejabat.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="mt-0.5 font-semibold text-sabah-batik-700">Sabtu, Ahad & Cuti Umum:</span>
                <span>Paling meriah, sesuai untuk suasana pasar tempatan.</span>
              </li>
            </ul>
          </div>
          <div class="rounded-2xl bg-white/80 p-5 border border-sabah-ocean-100/60">
            <p class="text-sm font-bold text-sabah-ocean-800 mb-2">🌤️ Iklim Kota Kinabalu</p>
            <p class="text-sm text-sabah-ocean-700 leading-relaxed">
              Suhu sepanjang tahun antara 24°C – 32°C, dengan kelembapan tinggi.
              Musim hujan utama berlaku pada bulan November – Februari, namun
              hujan biasanya berlaku pada waktu petang. Bawa payung mini untuk
              lindungan matahari atau hujan rencana.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 7: PARKIR -->
  <section id="parkir" class="scroll-mt-24 bg-sabah-wood-50/60">
    <div class="container py-16 md:py-20">
      <div class="max-w-3xl mb-10 md:mb-12">
        <span class="section-eyebrow">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg>
          Maklumat Parkir
        </span>
        <h2 class="section-title mt-3">Di Mana Hendak Letak Kereta?</h2>
        <p class="mt-3 text-sabah-ocean-700 leading-prose">
          Parkir di sepanjang Jalan Tun Fuad Stephen adalah terhad dan cepat
          penuh. Berikut adalah pilihan tempat parkir terbaik berhampiran
          Pasar Kraftangan untuk rujukan anda.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        {PARKING.map((p) => (
          <article class="card p-5 md:p-6 flex flex-col gap-4">
            <div class="flex items-start gap-4">
              <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-sabah-wood-200 text-sabah-wood-700">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg>
              </span>
              <div class="min-w-0 flex-1">
                <h3 class="font-display text-lg font-bold text-sabah-ocean-900 leading-snug">
                  {p.name}
                </h3>
                <p class="text-sm text-sabah-ocean-600 mt-0.5">Jarak: {p.distance}</p>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-3 rounded-xl bg-sabah-sand-50 p-4 text-sm">
              <div>
                <p class="text-xs uppercase tracking-wider text-sabah-ocean-500 font-semibold">Kadar</p>
                <p class="mt-1 font-bold text-sabah-ocean-900">{p.rate}</p>
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider text-sabah-ocean-500 font-semibold">Kapasiti</p>
                <p class="mt-1 font-bold text-sabah-ocean-900">{p.capacity}</p>
              </div>
            </div>
            <p class="text-sm text-sabah-ocean-700 leading-relaxed">{p.notes}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 8: PENGANGKUTAN (DETAILED) -->
  <section id="pengangkutan" class="scroll-mt-24">
    <div class="container py-16 md:py-20">
      <div class="max-w-3xl mb-10 md:mb-12">
        <span class="section-eyebrow">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 17h14M5 17a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2M5 17l-1 3M19 17l1 3M8 13V7M16 13V7"/></svg>
          Pengangkutan Terperinci
        </span>
        <h2 class="section-title mt-3">Cara Ke Pasar Kraftangan</h2>
        <p class="mt-3 text-sabah-ocean-700 leading-prose">
          Berikut adalah 6 cara untuk ke Pasar Kraftangan Kota Kinabalu, dari
          Lapangan Terbang, pusat bandar, dan sekitarnya. Panduan langkah demi
          langkah termasuk anggaran kos dan tempoh perjalanan.
        </p>
      </div>

      <div class="space-y-5">
        {TRANSPORT.map((t, idx) => (
          <details
            class={`card overflow-hidden transition ${idx === 0 ? 'open' : ''}`}
            {...(idx === 0 ? { open: true } : {})}
          >
            <summary class="list-none cursor-pointer">
              <div class="flex flex-wrap items-center gap-4 px-5 py-5 md:px-6 md:py-6 hover:bg-sabah-sand-50 transition pr-14 relative">
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-sabah-ocean-100 text-sabah-ocean-700 text-lg">
                  {modeLabels[t.mode]?.icon ?? '📍'}
                </span>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="chip">{modeLabels[t.mode]?.label ?? t.mode}</span>
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-sabah-wood-700">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      {t.duration}
                    </span>
                  </div>
                  <h3 class="mt-1.5 font-display text-lg md:text-xl font-bold text-sabah-ocean-900 leading-snug pr-4">
                    {t.title}
                  </h3>
                  <p class="mt-1 text-sm text-sabah-ocean-600 font-semibold">Anggaran kos: {t.cost}</p>
                </div>
                <span class="absolute right-5 top-1/2 -translate-y-1/2 inline-flex h-9 w-9 items-center justify-center rounded-full bg-sabah-ocean-50 text-sabah-ocean-600 group-open:rotate-180 transition open:rotate-180">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </span>
              </div>
            </summary>
            <div class="px-5 pb-6 md:px-6 md:pb-7 md:pl-[5.25rem] pl-[4.25rem] grid lg:grid-cols-5 gap-6">
              <div class="lg:col-span-3">
                <p class="text-xs font-semibold uppercase tracking-wider text-sabah-ocean-500 mb-3">Langkah-langkah</p>
                <ol class="space-y-3 text-sm text-sabah-ocean-800">
                  {t.steps.map((step, i) => (
                    <li class="flex gap-3">
                      <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-sabah-ocean-900 text-white text-xs font-bold">
                        {i + 1}
                      </span>
                      <span class="leading-relaxed">{step}</span>
                    </li>
                  ))}
                </ol>
              </div>
              <div class="lg:col-span-2">
                <p class="text-xs font-semibold uppercase tracking-wider text-sabah-wood-600 mb-2">💡 Petua Berguna</p>
                <div class="rounded-xl bg-sabah-wood-50 border border-sabah-wood-100 p-4 text-sm text-sabah-wood-900 leading-relaxed">
                  {t.tips}
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 9: MAKANAN BERDEKATAN -->
  <section id="makanan" class="scroll-mt-24 pattern-weave">
    <div class="container py-16 md:py-20">
      <div class="max-w-3xl mb-10 md:mb-12">
        <span class="section-eyebrow">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
          Makanan Berdekatan
        </span>
        <h2 class="section-title mt-3">Di Mana Hendak Makan?</h2>
        <p class="mt-3 text-sabah-ocean-700 leading-prose">
          Dari food court bawah pasar dengan harga poket, hingga restoran
          makanan laut mewah di tepi laut — 6 pilihan tempat makan terbaik
          dalam lingkungan 10 minit dari Pasar Kraftangan.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {FOOD_SPOTS.map((m) => (
          <article class="card p-5 md:p-6">
            <div class="flex items-start justify-between gap-3 mb-3">
              <h3 class="font-display text-lg font-bold text-sabah-ocean-900 leading-snug">{m.name}</h3>
              <span class={`shrink-0 inline-flex items-center rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider ${priceBadge[m.price]}`}>
                {priceLabel[m.price]}
              </span>
            </div>
            <p class="text-xs font-semibold text-sabah-ocean-500 uppercase tracking-wider">Jarak dari pasar</p>
            <p class="text-sm font-semibold text-sabah-ocean-800">{m.distance}</p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {m.specialty.map((sp) => (
                <li class="chip">{sp}</li>
              ))}
            </ul>
            <p class="mt-4 text-sm text-sabah-ocean-700 leading-relaxed">{m.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 10: TEMPAT MENARIK BERDEKATAN -->
  <section id="tempat-menarik" class="scroll-mt-24">
    <div class="container py-16 md:py-20">
      <div class="max-w-3xl mb-10 md:mb-12">
        <span class="section-eyebrow">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          Tempat Menarik Berdekatan
        </span>
        <h2 class="section-title mt-3">Gabungkan Lawatan Anda</h2>
        <p class="mt-3 text-sabah-ocean-700 leading-prose">
          Pasar Kraftangan terletak di tengah-tengah pusat bandar. Manfaatkan
          lokasi strategik ini untuk meneroka 6 tempat menarik berhampiran —
          dari melawat pulau sehingga memanjat bukit Signal Hill untuk
          pemandangan panorama bandar.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {NEARBY_ATTRACTIONS.map((a) => (
          <article class="card overflow-hidden flex flex-col">
            <div class="px-5 pt-5 md:px-6 md:pt-6">
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="chip-accent">{a.category}</span>
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-sabah-ocean-600">
                  📍 {a.distance}
                </span>
              </div>
              <h3 class="font-display text-lg font-bold text-sabah-ocean-900 leading-snug">
                {a.name}
              </h3>
            </div>
            <div class="px-5 md:px-6 mt-3 text-sm text-sabah-ocean-700 leading-relaxed flex-1">
              <p>{a.highlight}</p>
            </div>
            <div class="mx-5 mt-4 mb-5 md:mx-6 md:mb-6 flex items-center justify-between border-t border-sabah-ocean-100 pt-4">
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-sabah-wood-700">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {a.duration}
              </span>
              <a href="#peta" class="text-xs font-semibold text-sabah-ocean-700 hover:text-sabah-ocean-900 inline-flex items-center gap-1">
                Lihat peta
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 11: PETA GOOGLE MAPS (ms / MY language) -->
  <section id="peta" class="scroll-mt-24 bg-sabah-ocean-950 text-white">
    <div class="container py-16 md:py-20">
      <div class="max-w-3xl mb-8 md:mb-10">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/15 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white/90">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6c0 .66-.08 1.29-.21 1.91L12 10.5l3.21-2.59A7.999 7.999 0 0 1 19 7v8.34a5.995 5.995 0 0 1-7 0V6Z"/><path d="M14 4.78V3l-5 3v1.78a8 8 0 0 0-5 3.57L3 9v8l1 1 5-2a6 6 0 0 0 10 0l5 2 1-1V9l-1-.65a8 8 0 0 0-5-3.57"/></svg>
          Peta Lokasi
        </span>
        <h2 class="mt-3 font-display text-2xl md:text-3xl font-bold text-white tracking-tight">
          Cari Lokasi di Google Maps
        </h2>
        <p class="mt-3 text-white/75 leading-prose">
          Buka terus dalam apl Google Maps untuk navigasi sehala dari lokasi
          semasa anda ke Pasar Kraftangan Kota Kinabalu, Sabah.
        </p>
      </div>

      <div class="rounded-3xl overflow-hidden border border-white/10 shadow-card bg-white/5">
        <iframe
          title="Peta Pasar Kraftangan Kota Kinabalu Sabah"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3968.097988344191!2d116.06700889678955!3d5.981244000000006!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x323b698e19648a97%3A0x9ea986320b1b2738!2sHandicraft%20Market!5e0!3m2!1szh-CN!2sus!4v1786529484361!5m2!1szh-CN!2sus"
          width="100%"
          height="480"
          style="border:0; display:block;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          class="min-h-[360px]"
        ></iframe>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-white/80">
        <span class="inline-flex items-start gap-2">
          <span class="mt-0.5 text-white/60">📍</span>
          <span class="max-w-xl">{SITE.address}</span>
        </span>
        <a
          href="https://maps.app.goo.gl/K6efgMeZnt2ZFhii7"
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="inline-flex items-center gap-2 rounded-xl bg-white px-4 py-2 text-xs font-bold text-sabah-ocean-900 hover:bg-sabah-sand-100 transition"
        >
          Buka dalam Google Maps
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 12: FAQ -->
  <FaqAccordion />

</BaseLayout>
