---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { SITE, GALLERY } from '@/consts';
import { guidePaths, type Locale } from '@/i18n/config';
import { translations } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];

const MODE_ICONS: Record<string, string> = {
  kapal_terbang: '✈',
  bas: '🚌',
  teksi: '🚕',
  grab: '📱',
  berjalan: '🚶',
  kereta: '🚗',
};

const priceBadge: Record<string, string> = {
  murah: 'bg-sabah-ocean-100 text-sabah-ocean-700',
  sederhana: 'bg-sabah-sand-200 text-sabah-wood-700',
  mewah: 'bg-sabah-batik-100 text-sabah-batik-700',
};

const ticketIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg>`;
const clockIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`;
const stopwatchIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2"/><path d="M5 3 2 6"/><path d="m22 6-3-3"/><path d="M9 2h6"/></svg>`;
const sunIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>`;
const keyInfoIcons: Record<string, string> = {
  ticket: ticketIcon,
  clock: clockIcon,
  stopwatch: stopwatchIcon,
  sun: sunIcon,
};
---

<BaseLayout locale={locale}>
  <!-- SECTION 1: HERO -->
  <section id="hero" class="relative overflow-hidden bg-sabah-ocean-950">
    <div class="relative h-[38vh] min-h-[240px] w-full">
      <img
        src={GALLERY[0]}
        alt={t.hero.h1}
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 hero-overlay" />
    </div>
    <div class="container relative py-8 md:py-12">
      <div class="max-w-3xl text-white">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/15 backdrop-blur border border-white/20 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-white/90">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          {t.hero.badge}
        </span>
        <h1 class="mt-5 text-white font-display text-4xl md:text-6xl font-bold tracking-tight leading-[1.1]">
          {t.hero.h1}
        </h1>
        <p class="mt-5 text-lg md:text-xl leading-relaxed text-white/90 max-w-2xl">
          {t.meta.description}
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="#kategori" class="btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            {t.hero.ctaProducts}
          </a>
          <a href="#pengangkutan" class="btn-secondary !bg-white/85 !text-sabah-ocean-900 hover:!bg-white">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2Z"/><path d="M12 2v4"/><path d="m16.2 7.8 2.9-2.9"/><path d="M18 12h4"/><path d="m19 16-3-2"/></svg>
            {t.hero.ctaTransport}
          </a>
        </div>
        <div class="mt-7 flex flex-wrap items-center gap-4 text-sm text-white/85">
          <span class="inline-flex items-center gap-2">
            <span class="inline-flex gap-0.5 text-amber-300" aria-hidden="true">★</span>
            <span class="font-semibold text-white">{SITE.ratingValue.toFixed(1)}</span>
            <span>· {SITE.reviewCount.toLocaleString(t.meta.htmlLang)} {t.hero.reviewsWord} · Google Maps · 2026-10-19</span>
          </span>
          <span class="h-4 w-px bg-white/25"></span>
          <span class="inline-flex items-center gap-1.5">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            {t.hero.hoursNote}
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="container py-6" aria-label="Sumber / Sources / 来源">
    <p class="text-sm leading-relaxed text-sabah-ocean-700">{t.map.intro}</p>
    <div class="mt-3 flex flex-wrap gap-4 text-sm underline underline-offset-4">
      <a href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer">Google Maps — Pasar Kraftangan</a>
      <a href="https://sabahtourism.com/destination/handicraft-market/?locale=en" target="_blank" rel="noopener noreferrer">Sabah Tourism — Anjung Kinabalu / Handicraft Market</a>
      <a href={guidePaths.shopping[locale]}>{t.guidesNav.shopping}</a>
      <a href="#peta">{t.map.title}</a>
    </div>
  </section>

  <!-- SECTION 2: KEY INFO CARDS -->
  <section id="info-penting" class="scroll-mt-24">
    <div class="container py-10 md:py-14">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {t.keyInfo.map((k) => (
          <div class="card p-5 md:p-6">
            <div class="flex items-start gap-4">
              <div class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-sabah-ocean-100 text-sabah-ocean-700">
                <Fragment set:html={keyInfoIcons[k.icon]} />
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-xs font-semibold uppercase tracking-wider text-sabah-ocean-500">{k.label}</p>
                <p class="mt-1 font-display text-lg md:text-xl font-bold text-sabah-ocean-900 break-words">{k.value}</p>
                <p class="mt-1 text-sm text-sabah-ocean-600">{k.sub}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 3: PRODUCT CATEGORIES -->
  <section id="kategori" class="scroll-mt-24 pattern-weave">
    <div class="container py-16 md:py-20">
      <div class="max-w-3xl mb-10 md:mb-12">
        <span class="section-eyebrow">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          {t.products.eyebrow}
        </span>
        <h2 class="section-title mt-3">{t.products.title}</h2>
        <p class="mt-3 text-sabah-ocean-700 leading-prose">{t.products.intro}</p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {t.products.categories.map((p, i) => (
          <article class="card p-6 hover:shadow-lg transition">
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-sabah-wood-100 text-sabah-wood-700 font-bold font-display">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="chip-accent">{p.tagline}</span>
            </div>
            <h3 class="font-display text-xl font-bold text-sabah-ocean-900 leading-snug">{p.title}</h3>
            <p class="mt-2 text-sm text-sabah-ocean-700 leading-relaxed">{p.description}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {p.items.map((it) => (
                <li class="chip">{it}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={guidePaths.shopping[locale]} class="btn-primary">
          {t.products.guideCta}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 4: GALLERY -->
  <section id="galeri" class="scroll-mt-24">
    <div class="container py-16 md:py-20">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10 md:mb-12">
        <div class="max-w-3xl">
          <span class="section-eyebrow">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            {t.gallery.eyebrow}
          </span>
          <h2 class="section-title mt-3">{t.gallery.title}</h2>
          <p class="mt-3 text-sabah-ocean-700 leading-prose">{t.gallery.intro}</p>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
        {GALLERY.map((src, i) => (
          <figure
            class={`group relative overflow-hidden rounded-xl bg-sabah-ocean-100 ${
              i === 0 || i === 11 ? 'md:col-span-2 md:row-span-2 aspect-square' : 'aspect-[4/5]'
            }`}
          >
            <img
              src={src}
              alt={t.gallery.alt(i + 1)}
              loading={i < 4 ? 'eager' : 'lazy'}
              decoding="async"
              class="h-full w-full object-cover group-hover:scale-105 transition duration-500"
              width="800"
              height="800"
            />
            <figcaption class="pointer-events-none absolute bottom-0 left-0 right-0 bg-gradient-to-t from-sabah-ocean-950/70 via-sabah-ocean-950/20 to-transparent p-3 text-xs font-medium text-white/90 opacity-0 group-hover:opacity-100 transition">
              {t.gallery.captionWord} #{String(i + 1).padStart(2, '0')}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 5: TICKETS & FEES -->
  <section id="tiket" class="scroll-mt-24 bg-sabah-ocean-50/60">
    <div class="container py-16 md:py-20">
      <div class="grid gap-10 lg:grid-cols-12 items-start">
        <div class="lg:col-span-5">
          <span class="section-eyebrow"><Fragment set:html={ticketIcon} />{t.tickets.eyebrow}</span>
          <h2 class="section-title mt-3">{t.tickets.title}</h2>
          <p class="mt-4 text-sabah-ocean-700 leading-prose">{t.tickets.intro}</p>
          <div class="mt-6 card p-5 border-sabah-batik-200 bg-sabah-batik-50/60">
            <p class="text-sm font-semibold text-sabah-batik-800 mb-2">{t.tickets.tipsTitle}</p>
            <ul class="text-sm text-sabah-ocean-800 space-y-1.5 leading-relaxed list-disc pl-5">
              {t.tickets.tips.map((tip) => (
                <li>{tip}</li>
              ))}
            </ul>
          </div>
        </div>
        <div class="lg:col-span-7">
          <div class="card overflow-hidden">
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-sabah-ocean-100 text-sm">
                <thead class="bg-sabah-ocean-900 text-white">
                  <tr>
                    {t.tickets.tableHeaders.map((h) => (
                      <th scope="col" class="text-left px-5 py-4 font-semibold tracking-wide">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody class="divide-y divide-sabah-ocean-100 bg-white">
                  {t.tickets.ticketInfo.map((tk) => (
                    <tr class="hover:bg-sabah-sand-50">
                      <td class="px-5 py-4 font-semibold text-sabah-ocean-900">{tk.type}</td>
                      <td class="px-5 py-4">
                        <span class="inline-flex items-center gap-2 rounded-full bg-sabah-ocean-100 px-3 py-1 text-xs font-bold text-sabah-ocean-700">{tk.price}</span>
                      </td>
                      <td class="px-5 py-4 text-sabah-ocean-700">{tk.note}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 6: BEST TIME -->
  <section id="masa-terbaik" class="scroll-mt-24">
    <div class="container py-16 md:py-20">
      <div class="max-w-3xl mb-10 md:mb-12">
        <span class="section-eyebrow">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          {t.bestTime.eyebrow}
        </span>
        <h2 class="section-title mt-3">{t.bestTime.title}</h2>
        <p class="mt-3 text-sabah-ocean-700 leading-prose">{t.bestTime.intro}</p>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        {t.bestTime.cards.map((c, idx) => (
          <article class={`card p-6 border-t-4 ${idx === 0 ? 'border-t-sabah-ocean-500' : idx === 1 ? 'border-t-sabah-wood-500' : 'border-t-sabah-batik-500'}`}>
            <div class="flex items-center gap-3 mb-4">
              <span class={`inline-flex h-10 w-10 items-center justify-center rounded-xl ${idx === 0 ? 'bg-sabah-ocean-100 text-sabah-ocean-700' : idx === 1 ? 'bg-sabah-wood-100 text-sabah-wood-700' : 'bg-sabah-batik-100 text-sabah-batik-700'}`}>
                {idx === 0 && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 8 1.45-2.9A2 2 0 0 1 9.24 4H20a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2Z"/></svg>
                )}
                {idx === 1 && sunIcon}
                {idx === 2 && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 21a8 8 0 0 0-16 0"/><circle cx="10" cy="8" r="5"/><path d="M22 16a5 5 0 0 0-5-5"/><path d="M17 22h4"/></svg>
                )}
              </span>
              <h3 class="font-display text-xl font-bold text-sabah-ocean-900">{c.title}</h3>
            </div>
            <p class="text-xs font-semibold text-sabah-wood-600 uppercase tracking-wider">{c.badge}</p>
            <p class="mt-2 font-bold text-sabah-ocean-900">{c.time}</p>
            <ul class="mt-3 text-sm text-sabah-ocean-700 space-y-1.5 list-disc pl-5">
              {c.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="mt-10 card p-6 md:p-8 bg-gradient-to-br from-sabah-ocean-50 to-sabah-sand-50 border-sabah-ocean-200">
        <div class="grid gap-6 md:grid-cols-2 items-start">
          <div>
            <p class="font-display text-lg md:text-xl font-bold text-sabah-ocean-900">{t.bestTime.bestDayTitle}</p>
            <ul class="mt-3 text-sm text-sabah-ocean-800 space-y-2 leading-relaxed">
              {t.bestTime.dayRows.map((row) => (
                <li class="flex items-start gap-2">
                  <span class="mt-0.5 font-semibold text-sabah-ocean-700">{row.label}</span>
                  <span>{row.text}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="rounded-2xl bg-white/80 p-5 border border-sabah-ocean-100/60">
            <p class="text-sm font-bold text-sabah-ocean-800 mb-2">{t.bestTime.climateTitle}</p>
            <p class="text-sm text-sabah-ocean-700 leading-relaxed">{t.bestTime.climateText}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 7: PARKING -->
  <section id="parkir" class="scroll-mt-24 bg-sabah-wood-50/60">
    <div class="container py-16 md:py-20">
      <div class="max-w-3xl mb-10 md:mb-12">
        <span class="section-eyebrow">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg>
          {t.parking.eyebrow}
        </span>
        <h2 class="section-title mt-3">{t.parking.title}</h2>
        <p class="mt-3 text-sabah-ocean-700 leading-prose">{t.parking.intro}</p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        {t.parking.spots.map((p) => (
          <article class="card p-5 md:p-6 flex flex-col gap-4">
            <div class="flex items-start gap-4">
              <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-sabah-wood-200 text-sabah-wood-700">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg>
              </span>
              <div class="min-w-0 flex-1">
                <h3 class="font-display text-lg font-bold text-sabah-ocean-900 leading-snug">{p.name}</h3>
                <p class="text-sm text-sabah-ocean-600 mt-0.5">{p.distance}</p>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-3 rounded-xl bg-sabah-sand-50 p-4 text-sm">
              <div>
                <p class="text-xs uppercase tracking-wider text-sabah-ocean-500 font-semibold">{t.parking.rateLabel}</p>
                <p class="mt-1 font-bold text-sabah-ocean-900">{p.rate}</p>
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider text-sabah-ocean-500 font-semibold">{t.parking.capacityLabel}</p>
                <p class="mt-1 font-bold text-sabah-ocean-900">{p.capacity}</p>
              </div>
            </div>
            <p class="text-sm text-sabah-ocean-700 leading-relaxed">{p.notes}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 8: TRANSPORT -->
  <section id="pengangkutan" class="scroll-mt-24">
    <div class="container py-16 md:py-20">
      <div class="max-w-3xl mb-10 md:mb-12">
        <span class="section-eyebrow">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 17h14M5 17a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2M5 17l-1 3M19 17l1 3M8 13V7M16 13V7"/></svg>
          {t.transport.eyebrow}
        </span>
        <h2 class="section-title mt-3">{t.transport.title}</h2>
        <p class="mt-3 text-sabah-ocean-700 leading-prose">{t.transport.intro}</p>
      </div>

      <div class="space-y-5">
        {t.transport.options.map((tr, idx) => (
          <details
            class={`card overflow-hidden transition ${idx === 0 ? 'open' : ''}`}
            {...(idx === 0 ? { open: true } : {})}
          >
            <summary class="list-none cursor-pointer">
              <div class="flex flex-wrap items-center gap-4 px-5 py-5 md:px-6 md:py-6 hover:bg-sabah-sand-50 transition pr-14 relative">
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-sabah-ocean-100 text-sabah-ocean-700 text-lg">
                  {MODE_ICONS[tr.mode] ?? '📍'}
                </span>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="chip">{t.transport.modeLabels[tr.mode as keyof typeof t.transport.modeLabels] ?? tr.mode}</span>
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-sabah-wood-700">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      {tr.duration}
                    </span>
                  </div>
                  <h3 class="mt-1.5 font-display text-lg md:text-xl font-bold text-sabah-ocean-900 leading-snug pr-4">{tr.title}</h3>
                  <p class="mt-1 text-sm text-sabah-ocean-600 font-semibold">{t.transport.costPrefix} {tr.cost}</p>
                </div>
                <span class="absolute right-5 top-1/2 -translate-y-1/2 inline-flex h-9 w-9 items-center justify-center rounded-full bg-sabah-ocean-50 text-sabah-ocean-600 group-open:rotate-180 transition open:rotate-180">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                </span>
              </div>
            </summary>
            <div class="px-5 pb-6 md:px-6 md:pb-7 md:pl-[5.25rem] pl-[4.25rem] grid lg:grid-cols-5 gap-6">
              <div class="lg:col-span-3">
                <p class="text-xs font-semibold uppercase tracking-wider text-sabah-ocean-500 mb-3">{t.transport.stepsLabel}</p>
                <ol class="space-y-3 text-sm text-sabah-ocean-800">
                  {tr.steps.map((step, i) => (
                    <li class="flex gap-3">
                      <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-sabah-ocean-900 text-white text-xs font-bold">{i + 1}</span>
                      <span class="leading-relaxed">{step}</span>
                    </li>
                  ))}
                </ol>
              </div>
              <div class="lg:col-span-2">
                <p class="text-xs font-semibold uppercase tracking-wider text-sabah-wood-600 mb-2">{t.transport.tipsLabel}</p>
                <div class="rounded-xl bg-sabah-wood-50 border border-sabah-wood-100 p-4 text-sm text-sabah-wood-900 leading-relaxed">
                  {tr.tips}
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 9: FOOD NEARBY -->
  <section id="makanan" class="scroll-mt-24 pattern-weave">
    <div class="container py-16 md:py-20">
      <div class="max-w-3xl mb-10 md:mb-12">
        <span class="section-eyebrow">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
          {t.food.eyebrow}
        </span>
        <h2 class="section-title mt-3">{t.food.title}</h2>
        <p class="mt-3 text-sabah-ocean-700 leading-prose">{t.food.intro}</p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {t.food.spots.map((m) => (
          <article class="card p-5 md:p-6">
            <div class="flex items-start justify-between gap-3 mb-3">
              <h3 class="font-display text-lg font-bold text-sabah-ocean-900 leading-snug">{m.name}</h3>
              <span class={`shrink-0 inline-flex items-center rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider ${priceBadge[m.price]}`}>
                {t.food.priceLabels[m.price as keyof typeof t.food.priceLabels]}
              </span>
            </div>
            <p class="text-xs font-semibold text-sabah-ocean-500 uppercase tracking-wider">{t.food.distanceLabel}</p>
            <p class="text-sm font-semibold text-sabah-ocean-800">{m.distance}</p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {m.specialty.map((sp) => (
                <li class="chip">{sp}</li>
              ))}
            </ul>
            <p class="mt-4 text-sm text-sabah-ocean-700 leading-relaxed">{m.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 10: NEARBY ATTRACTIONS -->
  <section id="tempat-menarik" class="scroll-mt-24">
    <div class="container py-16 md:py-20">
      <div class="max-w-3xl mb-10 md:mb-12">
        <span class="section-eyebrow">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          {t.nearby.eyebrow}
        </span>
        <h2 class="section-title mt-3">{t.nearby.title}</h2>
        <p class="mt-3 text-sabah-ocean-700 leading-prose">{t.nearby.intro}</p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {t.nearby.attractions.map((a) => (
          <article class="card overflow-hidden flex flex-col">
            <div class="px-5 pt-5 md:px-6 md:pt-6">
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="chip-accent">{a.category}</span>
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-sabah-ocean-600">📍 {a.distance}</span>
              </div>
              <h3 class="font-display text-lg font-bold text-sabah-ocean-900 leading-snug">{a.name}</h3>
            </div>
            <div class="px-5 md:px-6 mt-3 text-sm text-sabah-ocean-700 leading-relaxed flex-1">
              <p>{a.highlight}</p>
            </div>
            <div class="mx-5 mt-4 mb-5 md:mx-6 md:mb-6 flex items-center justify-between border-t border-sabah-ocean-100 pt-4">
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-sabah-wood-700">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {a.duration}
              </span>
              <a href="#peta" class="text-xs font-semibold text-sabah-ocean-700 hover:text-sabah-ocean-900 inline-flex items-center gap-1">
                {t.nearby.viewMapLabel}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={guidePaths.itinerary[locale]} class="btn-secondary">
          {t.nearby.guideCta}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 11: GOOGLE MAPS -->
  <section id="peta" class="scroll-mt-24 bg-sabah-ocean-950 text-white">
    <div class="container py-16 md:py-20">
      <div class="max-w-3xl mb-8 md:mb-10">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/15 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white/90">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6c0 .66-.08 1.29-.21 1.91L12 10.5l3.21-2.59A7.999 7.999 0 0 1 19 7v8.34a5.995 5.995 0 0 1-7 0V6Z"/><path d="M14 4.78V3l-5 3v1.78a8 8 0 0 0-5 3.57L3 9v8l1 1 5-2a6 6 0 0 0 10 0l5 2 1-1V9l-1-.65a8 8 0 0 0-5-3.57"/></svg>
          {t.map.eyebrow}
        </span>
        <h2 class="mt-3 font-display text-2xl md:text-3xl font-bold text-white tracking-tight">{t.map.title}</h2>
        <p class="mt-3 text-white/75 leading-prose">{t.map.intro}</p>
      </div>

      <div class="rounded-3xl overflow-hidden border border-white/10 shadow-card bg-white/5">
        <iframe
          title={t.map.iframeTitle}
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3968.097988344191!2d116.06700889678955!3d5.981244000000006!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x323b698e19648a97%3A0x9ea986320b1b2738!2sHandicraft%20Market!5e0!3m2!1szh-CN!2sus!4v1786529484361!5m2!1szh-CN!2sus"
          width="100%"
          height="480"
          style="border:0; display:block;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          class="min-h-[360px]"
        ></iframe>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-white/80">
        <span class="inline-flex items-start gap-2">
          <span class="mt-0.5 text-white/60">📍</span>
          <span class="max-w-xl">{SITE.address}</span>
        </span>
        <a
          href={SITE.mapsUrl}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="inline-flex items-center gap-2 rounded-xl bg-white px-4 py-2 text-xs font-bold text-sabah-ocean-900 hover:bg-sabah-sand-100 transition"
        >
          {t.map.openMapsLabel}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 12: FAQ -->
  <FaqAccordion locale={locale} />
</BaseLayout>
