---
import { SITE } from '@/consts';
import { GUIDES, guidePaths, localePaths, type Locale } from '@/i18n/config';
import { translations } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];
---

<footer class="border-t border-sabah-ocean-100/70 bg-sabah-ocean-950 text-sabah-ocean-100 pattern-weave">
  <div class="container py-12 md:py-16 grid gap-10 md:grid-cols-12 items-start">
    <div class="md:col-span-5">
      <div class="flex items-center gap-3 mb-4">
        <img src="/favicon.svg" alt="" width="40" height="40" />
        <span class="font-display text-xl font-bold text-white">{t.meta.name}</span>
      </div>
      <p class="text-sm leading-relaxed text-sabah-ocean-200 max-w-md">
        {t.footer.about}
      </p>
      <div class="mt-5 text-xs text-sabah-ocean-400 space-y-1">
        <p>📍 {SITE.address}</p>
        <p>{t.footer.locationLine}</p>
      </div>
    </div>
    <div class="md:col-span-4">
      <h4 class="font-display text-base font-bold text-white mb-3">{t.footer.quickLinksTitle}</h4>
      <ul class="text-sm grid grid-cols-2 gap-2 text-sabah-ocean-200">
        {t.footer.quickLinks.map((link) => (
          <li>
            <a href={`${localePaths[locale]}${link.href}`} class="hover:text-white underline-offset-2 hover:underline">{link.label}</a>
          </li>
        ))}
      </ul>
      <h5 class="font-display text-sm font-bold text-white mt-6 mb-3">{t.guides.relatedTitle}</h5>
      <ul class="text-sm grid grid-cols-2 gap-2 text-sabah-ocean-200">
        {GUIDES.map((k) => (
          <li>
            <a href={guidePaths[k][locale]} class="hover:text-white underline-offset-2 hover:underline">{t.guidesNav[k]}</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="md:col-span-3">
      <h4 class="font-display text-base font-bold text-white mb-3">{t.footer.disclaimerTitle}</h4>
      <div class="rounded-2xl border border-sabah-ocean-800 bg-sabah-ocean-900/60 p-4 text-xs leading-relaxed text-sabah-ocean-300 space-y-2">
        <p class="font-semibold text-sabah-ocean-100">{t.footer.disclaimerTitle}</p>
        <p>{t.footer.disclaimerBody1}</p>
        <p>{t.footer.disclaimerBody2}</p>
      </div>
    </div>
  </div>
  <div class="border-t border-sabah-ocean-800/70">
    <div class="container py-5 flex flex-col md:flex-row items-center justify-between gap-3 text-xs text-sabah-ocean-400">
      <p>© {new Date().getFullYear()} {t.meta.name}. {t.footer.copyrightSuffix}</p>
      <a href="#atas" class="inline-flex items-center gap-1.5 hover:text-sabah-ocean-100 transition">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"/></svg>
        {t.footer.backToTop}
      </a>
    </div>
  </div>
</footer>
