---
import { GUIDES, LOCALES, guidePaths, localeLabels, localePaths, pagePaths, type PageKey, type Locale } from '@/i18n/config';
import { translations } from '@/i18n/ui';

interface Props {
  locale: Locale;
  pageKey?: PageKey;
}

const { locale, pageKey = 'home' } = Astro.props;
const t = translations[locale];

const otherLocales = LOCALES.filter((l) => l !== locale);
---

<header id="atas" class="sticky top-0 z-40 border-b border-sabah-ocean-100/60 bg-sabah-sand-50/85 backdrop-blur">
  <div class="container flex min-h-16 py-3 flex-wrap items-center justify-between gap-4">
    <a href={`${localePaths[locale]}#atas`} class="flex items-center gap-3 group" aria-label={t.meta.name}>
      <img src="/logo.svg" alt="" width="180" height="60" class="h-10 w-auto group-hover:scale-[1.02] transition" />
    </a>
    <nav class="hidden lg:block" aria-label={t.header.navAria}>
      <ul class="flex flex-wrap items-center gap-x-1 gap-y-2 text-sm font-medium">
        {t.nav.map((s) => (
          <li>
            <a
              href={`${localePaths[locale]}#${s.id}`}
              class="rounded-lg px-3 py-1.5 text-sabah-ocean-700 hover:bg-sabah-ocean-100 hover:text-sabah-ocean-900 transition"
            >
              {s.label}
            </a>
          </li>
        ))}
        {GUIDES.map((k) => (
          <li>
            <a
              href={guidePaths[k][locale]}
              class="rounded-lg px-3 py-1.5 text-sabah-batik-700 hover:bg-sabah-batik-50 hover:text-sabah-batik-900 transition"
            >
              {t.guidesNav[k]}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <nav aria-label="Language" class="hidden sm:flex items-center gap-0.5 rounded-lg bg-sabah-ocean-100/70 p-0.5">
        <span class="px-2 text-xs font-bold text-sabah-ocean-900">{localeLabels[locale]}</span>
        {otherLocales.map((l) => (
          <a
            href={pagePaths[pageKey][l]}
            hreflang={l}
            class="rounded-md px-2 py-1 text-xs font-semibold text-sabah-ocean-600 hover:bg-white hover:text-sabah-ocean-900 transition"
          >
            {localeLabels[l]}
          </a>
        ))}
      </nav>
      <a href={`${localePaths[locale]}#tiket`} class="btn-primary hidden xl:inline-flex">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg>
        {t.header.visitUs}
      </a>
      <details class="lg:hidden group relative">
        <summary aria-label={t.header.navAria} class="flex h-10 w-10 items-center justify-center rounded-lg text-sabah-ocean-700 hover:bg-sabah-ocean-100 list-none cursor-pointer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        </summary>
        <div class="absolute right-0 mt-2 w-64 rounded-2xl border border-sabah-ocean-100 bg-white p-3 shadow-card z-50">
          <ul class="flex flex-col gap-0.5 text-sm font-medium">
            {t.nav.map((s) => (
              <li>
                <a
                  href={`${localePaths[locale]}#${s.id}`}
                  class="block rounded-lg px-3 py-2 text-sabah-ocean-800 hover:bg-sabah-ocean-50"
                >
                  {s.label}
                </a>
              </li>
            ))}
            {GUIDES.map((k) => (
              <li>
                <a
                  href={guidePaths[k][locale]}
                  class="block rounded-lg px-3 py-2 text-sabah-batik-700 hover:bg-sabah-batik-50"
                >
                  {t.guidesNav[k]}
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-3 border-t border-sabah-ocean-100 pt-3">
            <ul class="flex items-center gap-2">
              {LOCALES.map((l) => (
                <li>
                  <a
                    href={pagePaths[pageKey][l]}
                    hreflang={l}
                    aria-current={l === locale ? 'page' : undefined}
                    class={`inline-flex rounded-lg px-3 py-1.5 text-sm font-semibold transition ${
                      l === locale
                        ? 'bg-sabah-ocean-900 text-white'
                        : 'bg-sabah-ocean-50 text-sabah-ocean-700 hover:bg-sabah-ocean-100'
                    }`}
                  >
                    {localeLabels[l]}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
