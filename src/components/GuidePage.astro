---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { GALLERY } from '@/consts';
import { GUIDES, guidePaths, localePaths, type GuideKey, type Locale } from '@/i18n/config';
import { translations } from '@/i18n/ui';

interface Props {
  locale: Locale;
  guide: GuideKey;
}

const { locale, guide } = Astro.props;
const t = translations[locale];
const g = t.guides[guide];

const HERO_IMAGES: Record<GuideKey, string> = {
  shopping: GALLERY[5],
  itinerary: GALLERY[12],
};

const otherGuides = GUIDES.filter((k) => k !== guide);
const homePath = localePaths[locale];
---

<BaseLayout
  locale={locale}
  title={g.meta.title}
  description={g.meta.description}
  image={HERO_IMAGES[guide]}
  pageKey={guide}
  schema="guide"
  faq={g.faq.items}
  breadcrumbs={[{ name: t.guidesNav[guide], pageKey: guide }]}
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-sabah-ocean-950 text-white">
    <div class="relative h-[42vh] min-h-[280px] w-full">
      <img
        src={HERO_IMAGES[guide]}
        alt={g.h1}
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 hero-overlay"></div>
    </div>
    <div class="container relative -mt-20 pb-10 md:pb-12">
      <nav aria-label="breadcrumb" class="mb-4 text-xs font-semibold text-white/80">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={homePath} class="hover:text-white underline-offset-2 hover:underline">{t.meta.name}</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-white">{t.guidesNav[guide]}</li>
        </ol>
      </nav>
      <span class="inline-flex items-center gap-2 rounded-full bg-white/15 backdrop-blur border border-white/20 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-white/90">
        {g.eyebrow}
      </span>
      <h1 class="mt-4 font-display text-3xl md:text-5xl font-bold tracking-tight leading-[1.15] max-w-4xl">
        {g.h1}
      </h1>
      <p class="mt-5 text-base md:text-lg leading-relaxed text-white/85 max-w-3xl">{g.intro}</p>
    </div>
  </section>

  <!-- BLOCKS -->
  <section class="scroll-mt-24">
    <div class="container py-14 md:py-16">
      <div class="space-y-6">
        {g.blocks.map((b, i) => (
          <article class="card p-6 md:p-8">
            <div class="flex flex-wrap items-center gap-3 mb-3">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-sabah-ocean-100 text-sabah-ocean-700 font-bold font-display text-sm">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h2 class="font-display text-xl md:text-2xl font-bold text-sabah-ocean-900 leading-snug flex-1 min-w-[16rem]">
                {b.heading}
              </h2>
            </div>
            <p class="text-sm md:text-base text-sabah-ocean-700 leading-prose">{b.body}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {b.items.map((it) => (
                <li class="chip">{it}</li>
              ))}
            </ul>
            <div class="mt-5 rounded-xl bg-sabah-sand-50 border border-sabah-sand-200 px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wider text-sabah-wood-600">{g.noteLabel}</p>
              <p class="mt-1 text-sm font-semibold text-sabah-ocean-900 leading-relaxed">{b.note}</p>
            </div>
          </article>
        ))}
      </div>

      <!-- TIPS -->
      <div class="mt-8 card p-6 md:p-8 border-sabah-batik-200 bg-sabah-batik-50/60">
        <p class="font-display text-lg md:text-xl font-bold text-sabah-batik-900">{g.tipsTitle}</p>
        <ul class="mt-3 text-sm text-sabah-ocean-800 space-y-2 leading-relaxed list-disc pl-5">
          {g.tips.map((tip) => (
            <li>{tip}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="scroll-mt-24 bg-sabah-ocean-50/60">
    <div class="container py-14 md:py-16">
      <div class="max-w-3xl mb-8 md:mb-10">
        <span class="section-eyebrow">{g.faq.eyebrow}</span>
        <h2 class="section-title mt-3">{g.faq.title}</h2>
        <p class="mt-3 text-sabah-ocean-700 leading-prose">{g.faq.intro}</p>
      </div>
      <div class="grid gap-3 max-w-4xl">
        {g.faq.items.map((f, i) => (
          <details class={`group card p-0 overflow-hidden transition ${i === 0 ? 'open' : ''}`} {...(i === 0 ? { open: true } : {})}>
            <summary class="flex cursor-pointer list-none items-start gap-4 px-5 py-4 md:px-6 md:py-5 hover:bg-sabah-sand-50 transition pr-14 relative">
              <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-sabah-ocean-100 text-sabah-ocean-700 text-xs font-bold">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="font-semibold text-sabah-ocean-900 leading-snug">{f.q}</span>
              <span class="absolute right-5 top-1/2 -translate-y-1/2 inline-flex h-8 w-8 items-center justify-center rounded-full bg-sabah-ocean-50 text-sabah-ocean-600 group-open:rotate-180 transition">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </span>
            </summary>
            <div class="px-5 pb-5 md:px-6 md:pb-6 pl-[4.25rem] md:pl-[4.75rem] text-sm text-sabah-ocean-700 leading-relaxed">
              {f.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- RELATED -->
  <section class="scroll-mt-24">
    <div class="container py-14 md:py-16">
      <h2 class="section-title">{t.guides.relatedTitle}</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {otherGuides.map((k) => (
          <a href={guidePaths[k][locale]} class="card p-5 md:p-6 hover:shadow-lg transition block">
            <p class="text-xs font-semibold uppercase tracking-wider text-sabah-ocean-500">{t.guidesNav[k]}</p>
            <p class="mt-2 font-display text-lg font-bold text-sabah-ocean-900 leading-snug">{t.guides[k].h1}</p>
            <p class="mt-2 text-sm text-sabah-ocean-700 leading-relaxed">{t.guides[k].meta.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-sabah-ocean-700">
              {t.guidesNav[k]}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </span>
          </a>
        ))}
        <a href={homePath} class="card p-5 md:p-6 hover:shadow-lg transition block border-sabah-ocean-200 bg-sabah-ocean-50/60">
          <p class="text-xs font-semibold uppercase tracking-wider text-sabah-ocean-500">{t.meta.name}</p>
          <p class="mt-2 font-display text-lg font-bold text-sabah-ocean-900 leading-snug">{t.guides.backHomeLabel}</p>
          <p class="mt-2 text-sm text-sabah-ocean-700 leading-relaxed">{t.guides.backHomeHint}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-sabah-ocean-700">
            {t.guides.backHomeLabel}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
